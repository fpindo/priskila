#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

$input = new ArgvInput;
$frontendProcess = null;

if (($input->getFirstArgument() === 'serve') && getenv('PRISKILA_SKIP_FRONTEND') !== '1') {
    $rootPath = dirname(__DIR__);
    $isWindows = PHP_OS_FAMILY === 'Windows';
    $command = $isWindows ? 'npm.cmd run dev -w frontend' : 'npm run dev -w frontend';

    $frontendProcess = proc_open($command, [
        0 => STDIN,
        1 => STDOUT,
        2 => STDERR,
    ], $pipes, $rootPath);

    register_shutdown_function(static function () use (&$frontendProcess): void {
        if (is_resource($frontendProcess)) {
            proc_terminate($frontendProcess);
        }
    });
}

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand($input);

exit($status);
