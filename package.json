{
  "name": "priskila-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PRISKILA - Project Inventory Stock & Logistics Application Monorepo",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "node start-dev.js",
    "build": "node start-build.js",
    "production": "node start-production.js",
    "start": "node start-production.js",
    "stop": "node stop-server.js",
    "dev:web": "npm run dev -w frontend",
    "build:web": "npm run build -w frontend",
    "start:web": "npm run start -w frontend",
    "lint:web": "npm run lint -w frontend",
    "format": "prettier --write ."
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "uuid": "11.1.1",
    "glob": "11.0.2",
    "rimraf": "6.0.1"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.0.0"
  }
}
